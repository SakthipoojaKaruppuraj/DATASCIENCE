.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
share/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDEs and Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Testing and Code Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Logs and Databases
*.log
*.sqlite
*.sqlite3

# Temporary / Scratch Files
*.tmp
*.bak
